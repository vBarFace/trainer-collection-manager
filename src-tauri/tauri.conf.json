{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trainer Collection Manager",
  "version": "0.1.0",
  "identifier": "org.trainercollectionmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trainer Collection Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "copyright": "Copyright (c) 2026 Trainer Collection Manager contributors"
  }
}
